{
  "name": "cs-465-full-stack-development-i",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha \"tests/unit/**/*.test.js\" --exit",
    "test:integration": "mocha \"tests/integration/**/*.test.js\" --exit",
    "test:smoke": "mocha \"tests/smoke/**/*.test.js\" --exit",
    "test:e2e": "mocha \"tests/e2e/**/*.test.js\" --exit",
    "test:backend": "npm run test:unit && npm run test:integration && npm run test:smoke",
    "test:frontend": "npm --prefix app_admin test",
    "test:all": "npm run test:backend && npm run test:frontend",
    "ci:seed": "node app_api/models/seed.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "hbs": "^4.2.1",
    "http-errors": "^2.0.1",
    "jquery": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "mongodb-memory-server": "^11.2.0",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2",
    "wait-on": "^8.0.0"
  }
}
